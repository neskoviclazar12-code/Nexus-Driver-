---
import Base from "../layouts/Base.astro";
import FormScript from "../components/FormScript.astro";
import { activeJobs } from "../data/jobs";

const list = activeJobs();
const states = ["AL","AR","AZ","CA","CO","CT","DC","DE","FL","GA","IA","ID","IL","IN","KS","KY","LA","MA","MD","ME","MI","MN","MO","MS","MT","NC","ND","NE","NH","NJ","NM","NV","NY","OH","OK","OR","PA","RI","SC","SD","TN","TX","UT","VA","VT","WA","WI","WV","WY"];
---
<Base
  title="Apply for a CDL-A Driving Job | Nexus Driver Solutions"
  description="Apply in two minutes, no resume needed. A Nexus recruiter calls you back to match you with a CDL-A company, 1099 or lease job."
>
  <section class="band">
    <div class="wrap">
      <p class="mono-label">Driver application</p>
      <h1 class="display">Two minutes. No resume.</h1>
      <p>Tell us the basics and pick a job, or leave it open and we'll match you. A recruiter calls or texts you back.</p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap apply">
      <form class="form card" data-nexus-form="driver_application" data-event="driver_application" data-success="Application received. A Nexus recruiter will call or text you shortly." novalidate>
        <div class="field" id="selected-job-wrap">
          <label for="job">Job you're applying for</label>
          <select id="job" name="job">
            <option value="">Match me with the best fit</option>
            {list.map((j) => <option value={j.slug}>{j.headline} · {j.title.split(":")[0]}</option>)}
          </select>
        </div>

        <div class="form__row">
          <div class="field"><label for="first_name">First name</label><input id="first_name" name="first_name" autocomplete="given-name" required /></div>
          <div class="field"><label for="last_name">Last name</label><input id="last_name" name="last_name" autocomplete="family-name" required /></div>
        </div>
        <div class="form__row">
          <div class="field"><label for="phone">Mobile phone</label><input id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" pattern="[0-9()+\-\s.]{10,}" required /></div>
          <div class="field"><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" required /></div>
        </div>
        <div class="form__row">
          <div class="field">
            <label for="state">State</label>
            <select id="state" name="state" required>
              <option value="">Select</option>
              {states.map((s) => <option>{s}</option>)}
            </select>
          </div>
          <div class="field"><label for="zip">ZIP code</label><input id="zip" name="zip" inputmode="numeric" pattern="[0-9]{5}" maxlength="5" autocomplete="postal-code" required /></div>
        </div>
        <div class="form__row">
          <div class="field">
            <label for="experience">CDL-A experience</label>
            <select id="experience" name="experience" required>
              <option value="">Select</option>
              <option>Less than 6 months</option>
              <option>6–12 months</option>
              <option>1–2 years</option>
              <option>2–3 years</option>
              <option>3+ years</option>
            </select>
          </div>
          <div class="field">
            <label for="position">Position type</label>
            <select id="position" name="position" required>
              <option value="">Select</option>
              <option>Company Driver</option>
              <option>1099 / Independent Contractor</option>
              <option>Team Driver</option>
              <option>Lease to Rent</option>
              <option>Lease to Purchase</option>
              <option>Open to anything</option>
            </select>
          </div>
        </div>
        <div class="field">
          <label for="trailer">Preferred trailer</label>
          <select id="trailer" name="trailer">
            <option value="">No preference</option>
            <option>Dry Van</option>
            <option>Reefer</option>
            <option>Open Deck (flatbed / stepdeck)</option>
          </select>
        </div>

        <div class="hp" aria-hidden="true"><label>Company website<input name="company_website" tabindex="-1" autocomplete="off" /></label></div>

        <label class="check">
          <input type="checkbox" name="sms_consent" value="yes" />
          <span>Optional: I agree that Nexus Driver Solutions may call and text me at the number above about driving jobs, including with automated technology. Consent is not a condition of any job. Message and data rates may apply; reply STOP to opt out. See our <a href="/sms-terms/">SMS Terms</a> and <a href="/privacy-policy/">Privacy Policy</a>.</span>
        </label>

        <button class="btn btn--dark" type="submit">Send my application</button>
        <p class="form-status" role="status" tabindex="-1" hidden></p>
      </form>

      <aside class="apply__side">
        <h2 class="display">What happens next</h2>
        <ol>
          <li><strong>A recruiter calls or texts you</strong> to go over your experience and what you're looking for.</li>
          <li><strong>We check the fit</strong> against the carrier's requirements, before anything is submitted.</li>
          <li><strong>You get the details</strong> on orientation, travel and your start date.</li>
        </ol>
        <p class="apply__note">We never ask for your SSN or license number on this form.</p>
      </aside>
    </div>
  </section>
  <FormScript />
</Base>

<script>
  // Preselect job from ?job=slug
  const slug = new URLSearchParams(location.search).get("job");
  const sel = document.getElementById("job") as HTMLSelectElement | null;
  if (slug && sel && [...sel.options].some((o) => o.value === slug)) sel.value = slug;
</script>

<style>
  .apply { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: clamp(28px, 5vw, 64px); align-items: start; }
  .card { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: clamp(20px, 4vw, 36px); }
  .card .btn { justify-self: start; }
  .apply__side h2 { font-size: 2rem; }
  .apply__side ol { margin: 16px 0 0; padding-left: 20px; display: grid; gap: 14px; color: var(--ink-2); }
  .apply__side strong { color: var(--ink); }
  .apply__note { margin-top: 20px; font-size: 0.875rem; color: var(--ink-3); }
  @media (max-width: 960px) { .apply { grid-template-columns: 1fr; } .card .btn { width: 100%; } }
</style>
