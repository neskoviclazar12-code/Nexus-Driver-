---
import Base from "../layouts/Base.astro";
import { SITE } from "../config";
const crumbs = { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
  { "@type": "ListItem", position: 1, name: "Home", item: SITE.url + "/" },
  { "@type": "ListItem", position: 2, name: "About", item: SITE.url + "/about/" } ] };
const aboutPage = { "@context": "https://schema.org", "@type": "AboutPage", name: "About Nexus Driver Solutions", url: SITE.url + "/about/" };
---
<Base title="About Nexus Driver Solutions | CDL Driver Recruiting" description="Nexus Driver Solutions is a CDL-A driver recruiting agency. We match Class A drivers with trucking carriers, and carriers pay only when a driver starts." schema={[aboutPage, crumbs]}>
  <section class="band">
    <div class="wrap">
      <p class="mono-label">About</p>
      <h1 class="display">About Nexus Driver Solutions</h1>
      <p>We sit between the application and the first load. Drivers get honest numbers before they commit. Carriers get drivers who fit how they actually run.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap prose">
      <h2>Who we are</h2>
      <p>{SITE.legalName} is a CDL-A driver recruiting agency. We recruit Class A drivers for trucking carriers across the United States and help drivers find the right seat: company driver, 1099, team, lease to rent and lease purchase, in dry van, reefer and open deck.</p>

      <h2>What we do for carriers</h2>
      <p>Carriers tell us their lanes, equipment, pay and hiring standards. We find CDL-A drivers who match, screen them against those rules, and send only the drivers worth a call. The carrier approves every driver. There is no retainer and no ad budget: our fee starts when the driver starts. <a href="/carriers/">How our CDL driver recruiting works →</a></p>

      <h2>What we do for drivers</h2>
      <p>Every job on our board lists pay, home time, truck and requirements before you apply. A recruiter who knows the carrier calls you back, answers the questions that matter and walks you through orientation. <a href="/cdl-jobs/">Browse current CDL-A jobs →</a></p>

      <h2>How we work</h2>
      <ul>
        <li><strong>Numbers up front.</strong> Average pay is shown as an average, never as a promise.</li>
        <li><strong>Carrier rules first.</strong> We only submit drivers who meet the carrier's requirements.</li>
        <li><strong>Confidential by default.</strong> Carrier names stay private on our site until a recruiter talks with you.</li>
      </ul>

      <h2>Contact</h2>
      <p>{SITE.legalName}<br />{SITE.address.street}, {SITE.address.city}, {SITE.address.region} {SITE.address.zip}<br /><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
      <p class="ctas"><a class="btn btn--blue" href={SITE.hireUrl}>Hire Drivers</a> <a class="btn btn--line" href="/apply/">Apply as a driver</a></p>
    </div>
  </section>
</Base>
<style>
  .prose { max-width: 46rem; }
  .prose h2 { font: 600 1.625rem/1.2 var(--font-display); letter-spacing: -0.02em; margin: 40px 0 10px; }
  .prose h2:first-child { margin-top: 0; }
  .prose p, .prose li { color: var(--ink-2); }
  .prose ul { padding-left: 20px; display: grid; gap: 8px; }
  .prose strong { color: var(--ink); }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
</style>
