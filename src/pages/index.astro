---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import JobCard from "../components/JobCard.astro";
import { activeJobs } from "../data/jobs";
import { SITE } from "../config";

const latest = activeJobs().slice(0, 3);
const total = activeJobs().length;
---
<Base
  title="Nexus Driver Solutions - CDL-A Recruiting Agency"
  description="Find CDL-A jobs with pay, home time and equipment shown up front, or hire screened CDL-A drivers and pay only when they start. Nexus Driver Solutions."
  schema={{ "@context": "https://schema.org", "@type": "WebSite", name: SITE.name, url: SITE.url }}
>
  <Hero />
  <!-- Carriers -->
  <section class="carriers" aria-labelledby="car-title">
    <div class="wrap carriers__in">
      <div>
        <p class="mono-label">For carriers</p>
        <h2 id="car-title" class="display carriers__title">Empty seats cost you every day. Our fee doesn't, until a driver starts.</h2>
      </div>
      <div>
        <ul class="carriers__list">
          <li><strong>No retainer, no ad spend.</strong> You pay per hire, only after the driver starts.</li>
          <li><strong>Screened to your rules.</strong> Experience, record, equipment and lanes, checked before you see a name.</li>
          <li><strong>You approve every driver.</strong> Nothing gets submitted without your yes.</li>
        </ul>
        <div class="carriers__cta">
          <a class="btn btn--blue" href="/carriers/">Hire Drivers</a>
          <a class="carriers__link" href={SITE.bookingUrl}>Book a 15-min call →</a>
        </div>
      </div>
    </div>
  </section>



  <section class="section about" id="about">
    <div class="wrap about__grid"><div><p class="mono-label">The people between the application and the first load</p><h2 class="display">Recruiting is personal.<br/>So is our approach.</h2></div><div><p>Nexus Driver Solutions connects CDL-A drivers with carriers across the United States. We bring the driver's experience and priorities together with the carrier's routes and hiring requirements.</p><p>From the first conversation through application follow-up and orientation coordination, our team helps both sides understand what comes next.</p><a class="about__contact" href={`mailto:${SITE.email}`}>Talk to the Nexus team ↗</a></div></div>
  </section>
  <!-- Drivers: how it works -->
  <section class="section" aria-labelledby="how-title">
    <div class="wrap how">
      <div>
        <p class="mono-label">For drivers</p>
        <h2 id="how-title" class="display how__title">Three steps from this page to the driver's seat.</h2>
      </div>
      <ol class="steps">
        <li>
          <span class="steps__n">01</span>
          <h3>Pick a job</h3>
          <p>Pay, home time, truck and requirements are on the page. If it doesn't fit, you know before anyone calls.</p>
        </li>
        <li>
          <span class="steps__n">02</span>
          <h3>Apply in two minutes</h3>
          <p>Name, phone, experience. No resume. Pick the job you want or let us match you.</p>
        </li>
        <li>
          <span class="steps__n">03</span>
          <h3>Talk to a recruiter</h3>
          <p>A recruiter who knows the carrier calls you back, answers the real questions and walks you to orientation.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- Jobs -->
  <section class="section section--alt" aria-labelledby="jobs-title">
    <div class="wrap">
      <div class="jobs-head">
        <div>
          <p class="mono-label">Open now</p>
          <h2 id="jobs-title" class="display jobs-head__title">CDL-A jobs hiring this week</h2>
        </div>
        <a class="btn btn--line" href="/cdl-jobs/">See all {total} jobs</a>
      </div>
      <div class="jobs-grid">
        {latest.map((job) => <JobCard job={job} />)}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="section final">
    <div class="wrap final__in">
      <h2 class="display final__title">Ready when you are.</h2>
      <div class="final__cta">
        <a class="btn btn--dark" href="/apply/">Apply as a driver</a>
        <a class="btn btn--line" href="/carriers/#inquiry">Request drivers</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .how { display: grid; grid-template-columns: 5fr 7fr; gap: clamp(32px, 6vw, 96px); align-items: start; }
  .how__title { font-size: clamp(2.25rem, 4vw, 3.25rem); margin-top: 12px; }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
  .steps li { display: grid; grid-template-columns: 64px 1fr; column-gap: 20px; padding: 22px 0; border-top: 1px solid var(--line); }
  .steps li:last-child { border-bottom: 1px solid var(--line); }
  .steps__n { grid-row: span 2; font: 700 2.25rem/1 var(--font-display); color: var(--blue); }
  .steps h3 { margin: 0; font: 700 1.5rem/1.1 var(--font-display); }
  .steps p { margin: 6px 0 0; color: var(--ink-2); max-width: 34rem; }

  .jobs-head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 20px; margin-bottom: 32px; }
  .jobs-head__title { font-size: clamp(2.25rem, 4vw, 3.25rem); margin-top: 12px; }
  .jobs-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }

  .carriers { background: var(--paper-2); color: var(--ink); padding: clamp(56px, 8vw, 112px) 0; position: relative; overflow: hidden; }
  .carriers::before { content: ""; position: absolute; left: 0; right: 0; top: 0; height: 4px; background: linear-gradient(90deg, var(--royal), var(--sky)); }
  .carriers .mono-label { color: var(--blue); }
  .carriers__in { display: grid; grid-template-columns: 6fr 5fr; gap: clamp(32px, 6vw, 96px); align-items: center; }
  .carriers__title { font-size: clamp(2rem, 3.5vw, 3rem); margin-top: 12px; }
  .carriers__trust { margin: 22px 0 0; display: inline-flex; align-items: center; gap: 10px; font-weight: 600; color: var(--ink); }
  .carriers__trust::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--blue); box-shadow: 0 0 0 4px rgb(25 106 249 / 0.15); }
  .carriers__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; color: var(--ink-2); }
  .carriers__list li { padding-left: 20px; position: relative; }
  .carriers__list li::before { content: ""; position: absolute; left: 0; top: 0.6em; width: 10px; height: 2px; background: var(--sky); }
  .carriers__list strong { color: var(--ink); }
  .carriers__cta { margin-top: 28px; display: flex; flex-wrap: wrap; gap: 14px 22px; align-items: center; }
  .carriers .btn--blue { background: var(--blue); color: #fff; }
  .carriers .btn--blue:hover { background: var(--sky); }
  .carriers__link { color: var(--ink); font-weight: 600; text-decoration: none; border-bottom: 2px solid var(--sky); padding-bottom: 2px; }
  .carriers__link:hover { color: var(--sky); }

  .final__in { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px; }
  .final__title { font-size: clamp(2.5rem, 5vw, 4rem); }
  .final__cta { display: flex; flex-wrap: wrap; gap: 12px; }

  @media (max-width: 960px) {
    .how, .carriers__in { grid-template-columns: 1fr; }
    .jobs-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) { .jobs-grid { grid-template-columns: 1fr; } }
</style>

<style>
.about__grid{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:start;}
.about h2{font-size:clamp(2rem,3.2vw,2.8rem);margin-top:18px;}
.about p{color:var(--ink-2);}.about .mono-label{color:var(--blue);}.about__contact{font-weight:600;text-underline-offset:5px;}
@media(max-width:760px){.about__grid{grid-template-columns:1fr;gap:20px;}}
</style>
