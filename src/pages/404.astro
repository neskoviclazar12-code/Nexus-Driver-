---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found | Nexus Driver Solutions" description="This page doesn't exist." noindex>
  <section class="band">
    <div class="wrap">
      <p class="mono-label">404 · Wrong exit</p>
      <h1 class="display">This road doesn't go anywhere.</h1>
      <p>The page you're looking for moved or never existed. The jobs are still right here.</p>
      <p style="margin-top:28px;display:flex;gap:12px;flex-wrap:wrap">
        <a class="btn" style="background:#fff;color:var(--navy)" href="/cdl-jobs/">See CDL-A Jobs</a>
        <a class="btn" style="color:#fff;box-shadow:inset 0 0 0 2px #fff" href="/">Back to home</a>
      </p>
    </div>
  </section>
</Base>
