---
import Base from "../../layouts/Base.astro";
import { SITE } from "../../config";

const faq = [
  { q: "When do we pay?", a: "Only after a driver we sent starts driving for you. There is no retainer and no ad budget." },
  { q: "Who decides which drivers get hired?", a: "You do. We screen to your requirements, and you approve every driver before they move forward." },
  { q: "What positions do you recruit for?", a: "CDL-A company drivers, 1099 drivers, teams, lease to rent and lease to purchase, across dry van, reefer and open deck." },
  { q: "How do we get started?", a: "Click Hire Drivers, find your company on FMCSA, answer a few questions about your fleet and pick a time for a 15-minute call. Before we start recruiting, we ask you to fill out our carrier questionnaire so we know your lanes, equipment and hiring rules." },
];
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};
---
<Base
  title="CDL Driver Recruiting Agency for Carriers | Nexus Driver Solutions"
  description="CDL-A driver recruiting for carriers. No retainer, no ad budget: screened drivers you approve, and you pay only when they start."
  schema={faqSchema}
>
  <section class="band">
    <div class="wrap">
      <p class="mono-label">For carriers · Trusted by 30+ carriers</p>
      <h1 class="display">CDL Driver Recruiting for Trucking Companies</h1>
      <p class="slogan">You pay when the wheels turn.</p>
      <p>No retainer. No ad budget. No pile of applications nobody screened. We find CDL-A drivers who fit your lanes and hiring rules, you approve them, and our fee starts the day they start.</p>
      <div class="band__cta">
        <a class="btn cta-white" href={SITE.hireUrl}>Hire Drivers</a>
        <span class="band__note">Starts with your FMCSA lookup · about 2 minutes</span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap process">
      <h2 class="display process__title">How it works</h2>
      <ol class="process__steps">
        <li><span>01</span><h3>Tell us what you need</h3><p>Lanes, equipment, position types, experience and record requirements, and how many seats are open.</p></li>
        <li><span>02</span><h3>We recruit and screen</h3><p>We source CDL-A drivers and check them against your rules before you see a single name.</p></li>
        <li><span>03</span><h3>You approve</h3><p>You review each driver. Only the ones you approve go to orientation.</p></li>
        <li><span>04</span><h3>You pay per hire</h3><p>Our fee starts when the driver starts. No starts, no invoice.</p></li>
      </ol>
    </div>
  </section>

  <section class="section section--alt" id="start">
    <div class="wrap start">
      <div>
        <p class="mono-label">Hire drivers</p>
        <h2 class="display start__title">Find your company. Tell us what you need. Pick a time.</h2>
      </div>
      <div>
        <ol class="start__list">
          <li>Look up your company on FMCSA by USDOT number or name.</li>
          <li>Answer a few quick questions: fleet size, driver pay, trailers, escrow, truck year and the drivers you need.</li>
          <li>Choose a day and time for a 15-minute call. We come to it already knowing your fleet.</li>
        </ol>
        <a class="btn btn--blue" href={SITE.hireUrl}>Hire Drivers</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap faq">
      <h2 class="display faq__title">Carrier FAQ</h2>
      <div>
        {faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .band__cta { margin-top: 28px; display: flex; flex-wrap: wrap; align-items: center; gap: 14px 22px; }
  .cta-white { background: #fff; color: var(--navy); }
  .cta-white:hover { background: var(--sky); }
  .slogan { font: 600 clamp(1.25rem, 2.2vw, 1.625rem)/1.2 var(--font-display); color: var(--sky) !important; margin-top: 14px !important; }
  .band__note { color: rgb(255 255 255 / 0.65); font-size: 0.875rem; }
  .start { display: grid; grid-template-columns: 5fr 6fr; gap: clamp(28px, 5vw, 72px); align-items: start; }
  .start__title { font-size: clamp(2rem, 3.6vw, 3rem); margin-top: 12px; }
  .start__list { margin: 0 0 28px; padding-left: 22px; display: grid; gap: 12px; color: var(--ink-2); }
  @media (max-width: 960px) { .start { grid-template-columns: 1fr; } }
  .band__link { color: #fff; font-weight: 600; text-decoration: none; border-bottom: 2px solid var(--sky); padding-bottom: 2px; }
  .band__link:hover { color: var(--sky); }

  .process__title, .faq__title { font-size: clamp(2.25rem, 4vw, 3.25rem); margin-bottom: 28px; }
  .process__steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 2px solid var(--navy); }
  .process__steps li { padding: 20px 20px 0 0; }
  .process__steps span { font: 700 2rem/1 var(--font-display); color: var(--blue); }
  .process__steps h3 { margin: 10px 0 6px; font: 700 1.375rem/1.1 var(--font-display); }
  .process__steps p { margin: 0; color: var(--ink-2); }

  .inquiry { display: grid; grid-template-columns: 5fr 7fr; gap: clamp(28px, 5vw, 72px); align-items: start; }
  .inquiry__title { font-size: clamp(2.25rem, 4vw, 3.25rem); margin-top: 12px; }
  .inquiry__lede { color: var(--ink-2); }
  .book { margin-top: 28px; padding: 20px; border: 1px dashed var(--line); border-radius: var(--radius); background: #fff; scroll-margin-top: 90px; }
  .book .mono-label { margin: 0; }
  .book p { color: var(--ink-2); }
  .card { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: clamp(20px, 4vw, 36px); }
  .card .btn { justify-self: start; }
  #inquiry { scroll-margin-top: 70px; }

  .faq { display: grid; grid-template-columns: 4fr 8fr; gap: clamp(28px, 5vw, 72px); }
  details { border-bottom: 1px solid var(--line); padding: 18px 0; }
  details:first-child { border-top: 1px solid var(--line); }
  summary { cursor: pointer; font: 700 1.375rem/1.2 var(--font-display); list-style: none; display: flex; justify-content: space-between; gap: 16px; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: "+"; color: var(--blue); }
  details[open] summary::after { content: "–"; }
  details p { margin: 10px 0 0; color: var(--ink-2); max-width: 44rem; }

  @media (max-width: 960px) {
    .process__steps { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 20px; }
    .inquiry, .faq { grid-template-columns: 1fr; }
    .card .btn { width: 100%; }
  }
  @media (max-width: 560px) { .process__steps { grid-template-columns: 1fr; } }
</style>
