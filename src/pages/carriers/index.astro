---
import Base from "../../layouts/Base.astro";
import FormScript from "../../components/FormScript.astro";
import { SITE } from "../../config";

const faq = [
  { q: "When do we pay?", a: "Only after a driver we sent starts driving for you. There is no retainer and no ad budget." },
  { q: "Who decides which drivers get hired?", a: "You do. We screen to your requirements, and you approve every driver before they move forward." },
  { q: "What positions do you recruit for?", a: "CDL-A company drivers, 1099 drivers, teams, lease to rent and lease to purchase, across dry van, reefer and open deck." },
  { q: "How do we get started?", a: "Book a 15-minute call or send the short form on this page. Before we start recruiting, we ask you to fill out our carrier questionnaire so we know your lanes, equipment and hiring rules." },
];
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};
---
<Base
  title="Truck Driver Recruiting Agency | Pay-Per-Hire CDL-A Recruiting | Nexus Driver Solutions"
  description="CDL-A driver recruiting for carriers. No retainer, no ad budget: screened drivers you approve, and you pay only when they start."
  schema={faqSchema}
>
  <section class="band">
    <div class="wrap">
      <p class="mono-label">For carriers · Trusted by 30+ carriers</p>
      <h1 class="display">You pay when the wheels turn.</h1>
      <p>No retainer. No ad budget. No pile of applications nobody screened. We find CDL-A drivers who fit your lanes and hiring rules, you approve them, and our fee starts the day they start.</p>
      <div class="band__cta">
        <a class="btn cta-white" href="#inquiry">Hire Drivers</a>
        <a class="band__link" href={SITE.bookingUrl}>Book a 15-min call →</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap process">
      <h2 class="display process__title">How it works</h2>
      <ol class="process__steps">
        <li><span>01</span><h3>Tell us what you need</h3><p>Lanes, equipment, position types, experience and record requirements, and how many seats are open.</p></li>
        <li><span>02</span><h3>We recruit and screen</h3><p>We source CDL-A drivers and check them against your rules before you see a single name.</p></li>
        <li><span>03</span><h3>You approve</h3><p>You review each driver. Only the ones you approve go to orientation.</p></li>
        <li><span>04</span><h3>You pay per hire</h3><p>Our fee starts when the driver starts. No starts, no invoice.</p></li>
      </ol>
    </div>
  </section>

  <section class="section section--alt" id="inquiry">
    <div class="wrap inquiry">
      <div>
        <p class="mono-label">Request drivers</p>
        <h2 class="display inquiry__title">Tell us about your open seats.</h2>
        <p class="inquiry__lede">Send the basics and we'll come back with next steps. Prefer to talk? <a href={SITE.bookingUrl}>Book a 15-minute call</a>.</p>
        <div id="book-a-call" class="book">
          <p class="mono-label">Book a call</p>
          <p>Find your company on FMCSA, tell us about your fleet and the drivers you need, and pick a time.</p>
          <a class="btn btn--line" href={SITE.bookingUrl}>Book a 15-min call</a>
        </div>
      </div>

      <form class="form card" data-nexus-form="carrier_inquiry" data-event="carrier_inquiry" data-success="Thanks. We'll reach out with next steps and our carrier questionnaire." novalidate>
        <div class="form__row">
          <div class="field"><label for="company">Company name</label><input id="company" name="company" autocomplete="organization" required /></div>
          <div class="field"><label for="contact">Your name</label><input id="contact" name="contact_name" autocomplete="name" required /></div>
        </div>
        <div class="form__row">
          <div class="field"><label for="mc">MC #</label><input id="mc" name="mc_number" inputmode="numeric" /></div>
          <div class="field"><label for="dot">DOT #</label><input id="dot" name="dot_number" inputmode="numeric" required /></div>
        </div>
        <div class="form__row">
          <div class="field"><label for="cphone">Phone</label><input id="cphone" name="phone" type="tel" autocomplete="tel" required /></div>
          <div class="field"><label for="cemail">Email</label><input id="cemail" name="email" type="email" autocomplete="email" required /></div>
        </div>
        <div class="form__row">
          <div class="field">
            <label for="seats">Drivers needed</label>
            <select id="seats" name="drivers_needed" required>
              <option value="">Select</option><option>1–5</option><option>6–15</option><option>16–30</option><option>30+</option>
            </select>
          </div>
          <div class="field">
            <label for="ctrailer">Trailer type</label>
            <select id="ctrailer" name="trailer" required>
              <option value="">Select</option><option>Dry Van</option><option>Reefer</option><option>Open Deck</option><option>Multiple</option>
            </select>
          </div>
        </div>
        <div class="field">
          <label for="positions">Positions you're hiring for</label>
          <input id="positions" name="positions" placeholder="e.g. company solo, teams, lease to purchase" />
        </div>
        <div class="field">
          <label for="notes">Lanes and requirements</label>
          <textarea id="notes" name="notes" placeholder="Operating area, minimum experience, record requirements, home time…"></textarea>
        </div>
        <div class="hp" aria-hidden="true"><label>Company website<input name="company_website" tabindex="-1" autocomplete="off" /></label></div>
        <button class="btn btn--dark" type="submit">Request drivers</button>
        <p class="form-status" role="status" tabindex="-1" hidden></p>
      </form>
    </div>
  </section>

  <section class="section">
    <div class="wrap faq">
      <h2 class="display faq__title">Carrier FAQ</h2>
      <div>
        {faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
  <FormScript />
</Base>

<style>
  .band__cta { margin-top: 28px; display: flex; flex-wrap: wrap; align-items: center; gap: 14px 22px; }
  .cta-white { background: #fff; color: var(--navy); }
  .cta-white:hover { background: var(--sky); }
  .band__link { color: #fff; font-weight: 600; text-decoration: none; border-bottom: 2px solid var(--sky); padding-bottom: 2px; }
  .band__link:hover { color: var(--sky); }

  .process__title, .faq__title { font-size: clamp(2.25rem, 4vw, 3.25rem); margin-bottom: 28px; }
  .process__steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 2px solid var(--navy); }
  .process__steps li { padding: 20px 20px 0 0; }
  .process__steps span { font: 700 2rem/1 var(--font-display); color: var(--blue); }
  .process__steps h3 { margin: 10px 0 6px; font: 700 1.375rem/1.1 var(--font-display); }
  .process__steps p { margin: 0; color: var(--ink-2); }

  .inquiry { display: grid; grid-template-columns: 5fr 7fr; gap: clamp(28px, 5vw, 72px); align-items: start; }
  .inquiry__title { font-size: clamp(2.25rem, 4vw, 3.25rem); margin-top: 12px; }
  .inquiry__lede { color: var(--ink-2); }
  .book { margin-top: 28px; padding: 20px; border: 1px dashed var(--line); border-radius: var(--radius); background: #fff; scroll-margin-top: 90px; }
  .book .mono-label { margin: 0; }
  .book p { color: var(--ink-2); }
  .card { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: clamp(20px, 4vw, 36px); }
  .card .btn { justify-self: start; }
  #inquiry { scroll-margin-top: 70px; }

  .faq { display: grid; grid-template-columns: 4fr 8fr; gap: clamp(28px, 5vw, 72px); }
  details { border-bottom: 1px solid var(--line); padding: 18px 0; }
  details:first-child { border-top: 1px solid var(--line); }
  summary { cursor: pointer; font: 700 1.375rem/1.2 var(--font-display); list-style: none; display: flex; justify-content: space-between; gap: 16px; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: "+"; color: var(--blue); }
  details[open] summary::after { content: "–"; }
  details p { margin: 10px 0 0; color: var(--ink-2); max-width: 44rem; }

  @media (max-width: 960px) {
    .process__steps { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 20px; }
    .inquiry, .faq { grid-template-columns: 1fr; }
    .card .btn { width: 100%; }
  }
  @media (max-width: 560px) { .process__steps { grid-template-columns: 1fr; } }
</style>
