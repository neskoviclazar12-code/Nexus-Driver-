---
import Base from "../../layouts/Base.astro";
import JobCard from "../../components/JobCard.astro";
import { activeJobs, type Job } from "../../data/jobs";
import { SITE } from "../../config";

export function getStaticPaths() {
  return activeJobs().map((job) => ({ params: { slug: job.slug }, props: { job } }));
}

const { job } = Astro.props as { job: Job };
const applyHref = `/apply/?job=${job.slug}`;

const related = activeJobs()
  .filter((j) => j.slug !== job.slug && j.divisions.some((d) => job.divisions.includes(d)))
  .slice(0, 3);

const validThrough = new Date(new Date(job.datePosted).getTime() + 60 * 864e5).toISOString().slice(0, 10);
const employmentType = job.positions.some((p) => p.startsWith("Lease") || p === "Independent Contractor")
  ? "CONTRACTOR"
  : "FULL_TIME";

const jobSchema = {
  "@context": "https://schema.org",
  "@type": "JobPosting",
  title: job.title,
  description: `<p>${job.summary}</p>` + job.sections.map((s) => `<h3>${s.title}</h3><ul>${s.items.map((i) => `<li>${i}</li>`).join("")}</ul>`).join(""),
  datePosted: job.datePosted,
  validThrough,
  employmentType,
  // Carrier name is kept confidential, so the posting is listed under Nexus.
  hiringOrganization: { "@type": "Organization", name: SITE.name, sameAs: SITE.url },
  jobLocation: {
    "@type": "Place",
    address: { "@type": "PostalAddress", addressRegion: job.region === "US" ? undefined : job.region, addressCountry: "US" },
  },
  applicantLocationRequirements: { "@type": "Country", name: "USA" },
  directApply: true,
  industry: "Trucking",
  occupationalCategory: "53-3032.00 Heavy and Tractor-Trailer Truck Drivers",
};
const crumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: SITE.url + "/" },
    { "@type": "ListItem", position: 2, name: "CDL-A Jobs", item: SITE.url + "/cdl-jobs/" },
    { "@type": "ListItem", position: 3, name: job.title, item: `${SITE.url}/cdl-jobs/${job.slug}/` },
  ],
};
---
<Base
  title={`${job.title} | Nexus Driver Solutions`}
  description={`${job.headline}. ${job.summary}`.slice(0, 158)}
  schema={[jobSchema, crumbs]}
>
  <section class="band">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/cdl-jobs/">← All CDL-A jobs</a></nav>
      <p class="mono-label">{job.divisions.join(" · ")} · {job.positions.join(" / ")}</p>
      <h1 class="display">{job.title}</h1>
      <p>{job.summary}</p>
      <div class="band__cta">
        <a class="btn apply-btn" href={applyHref}>Apply for this job</a>
        <span class="band__note">2 minutes · No resume needed</span>
      </div>
    </div>
  </section>

  <section class="stats" aria-label="Key facts">
    <div class="wrap stats__in">
      <div><span>Pay</span><strong>{job.headline}</strong></div>
      {job.avgWeekly && <div><span>Avg weekly</span><strong>{job.avgWeekly}</strong></div>}
      <div><span>Home time</span><strong>{job.homeTime}</strong></div>
      <div><span>Truck</span><strong>{job.truck}</strong></div>
      <div><span>Experience</span><strong>{job.minExperience}</strong></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap detail">
      <div class="detail__main">
        {job.rates && (
          <div class="rates">
            <h2 class="display rates__title">Pay rates</h2>
            <table>
              <tbody>
                {job.rates.map((r) => (
                  <tr><th scope="row">{r.label}</th><td>{r.value}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
        <div class="blocks">
          {job.sections.map((s) => (
            <div class="block">
              <h2 class="block__title">{s.title}</h2>
              <ul>{s.items.map((i) => <li>{i}</li>)}</ul>
            </div>
          ))}
        </div>
        <p class="fine">Pay, routes, equipment and policies are subject to confirmation with the carrier and your recruiter. Average pay is an average, not a guarantee.</p>
      </div>

      <aside class="side" aria-label="Apply">
        <div class="side__box">
          <p class="mono-label">{job.carrierLabel}</p>
          <p class="side__pay">{job.headline}</p>
          <p class="side__route">{job.route}</p>
          <a class="btn btn--dark side__btn" href={applyHref}>Apply for this job</a>
          <p class="side__small">A recruiter calls you back to go over the details and next steps.</p>
        </div>
      </aside>
    </div>
  </section>

  {related.length > 0 && (
    <section class="section section--alt">
      <div class="wrap">
        <h2 class="display related__title">Similar CDL-A jobs</h2>
        <div class="related">{related.map((j) => <JobCard job={j} />)}</div>
      </div>
    </section>
  )}

  <div class="sticky-apply">
    <a class="btn btn--dark" href={applyHref}>Apply for this job</a>
  </div>
</Base>

<style>
  .crumbs { margin-bottom: 20px; }
  .crumbs a { color: rgb(255 255 255 / 0.75); text-decoration: none; font-size: 0.9375rem; }
  .crumbs a:hover { color: #fff; }
  .band h1 { max-width: 22ch; }
  .band__cta { margin-top: 28px; display: flex; flex-wrap: wrap; align-items: center; gap: 12px 18px; }
  .apply-btn { background: #fff; color: var(--navy); }
  .apply-btn:hover { background: var(--sky); }
  .band__note { color: rgb(255 255 255 / 0.65); font-size: 0.875rem; }

  .stats { background: var(--navy-2); color: #fff; border-top: 1px solid rgb(255 255 255 / 0.08); }
  .stats__in { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); }
  .stats__in div { padding: 20px 20px 22px 0; border-right: 1px solid rgb(255 255 255 / 0.1); display: grid; gap: 4px; }
  .stats__in div:last-child { border-right: 0; }
  .stats span { font: 500 0.6875rem var(--font-mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--sky); }
  .stats strong { font: 700 1.375rem/1.15 var(--font-display); }

  .detail { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: clamp(32px, 5vw, 72px); align-items: start; }
  .rates { margin-bottom: 36px; }
  .rates__title, .related__title { font-size: 2rem; margin-bottom: 14px; }
  table { width: 100%; border-collapse: collapse; font-size: 1rem; }
  th, td { text-align: left; padding: 14px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
  th { font-weight: 600; width: 40%; padding-right: 16px; }
  td { font-variant-numeric: tabular-nums; color: var(--ink-2); }
  .blocks { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 40px; }
  .block__title { margin: 0 0 10px; font: 700 1.375rem/1.1 var(--font-display); padding-bottom: 8px; border-bottom: 2px solid var(--navy); }
  .block ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 8px; }
  .block li { padding-left: 18px; position: relative; color: var(--ink-2); }
  .block li::before { content: ""; position: absolute; left: 0; top: 0.72em; width: 8px; height: 2px; background: var(--blue); }
  .fine { margin-top: 36px; font-size: 0.8125rem; color: var(--ink-3); }

  .side { position: sticky; top: 92px; }
  .side__box { border: 1px solid var(--line); border-radius: var(--radius); padding: 24px; background: var(--paper-2); }
  .side__box .mono-label { margin: 0; }
  .side__pay { margin: 10px 0 2px; font: 700 2.25rem/1 var(--font-display); }
  .side__route { margin: 0 0 18px; color: var(--ink-2); }
  .side__btn { width: 100%; }
  .side__small { margin: 12px 0 0; font-size: 0.875rem; color: var(--ink-3); }

  .related { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }

  .sticky-apply { display: none; }
  @media (max-width: 960px) {
    .detail { grid-template-columns: 1fr; }
    .side { position: static; }
    .related { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .blocks { grid-template-columns: 1fr; }
    .stats__in div { border-right: 0; border-bottom: 1px solid rgb(255 255 255 / 0.1); padding: 14px 0; }
    .sticky-apply { display: block; position: sticky; bottom: 0; padding: 12px 16px; background: #fff; border-top: 1px solid var(--line); z-index: 40; }
    .sticky-apply .btn { width: 100%; }
  }
</style>
